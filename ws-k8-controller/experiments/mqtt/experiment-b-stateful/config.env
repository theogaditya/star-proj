CLUSTER_NAME=mqtt-exp-b
RESULT_DIR=results/raw/mqtt/experiment-b-stateful

# ── Phase 1: Burst Admission (StatefulAutoscaler scales up) ─────
# Same 1000 clients as Exp A — proving scale-up blindness is removed
# Clients retry on failure so they connect to newly-created pods
PHASE1_CLIENTS=1000
PHASE1_RAMP_SECONDS=60
PHASE1_DURATION=300

# ── Phase 2: Rebalance (drain-and-reconnect) ────────────────────
# Controller detects imbalance, triggers drain on hot pod
# Clients reconnect through Service to other pods → distribution balances
PHASE2_DURATION=240

# ── Phase 3: Live-client Scale-down (graceful drain) ────────────
# Reduce load by killing loadgen → some clients disconnect
# Then launch a smaller loadgen with 300 clients (keeps pods alive)
# Controller wants fewer replicas → drains before removing
# Monitor for gradual connection decrease, NOT cliff drop
PHASE3_DURATION=300
PHASE3_KEEP_CLIENTS=300

# Client retry config — critical for all 3 phases
MAX_RETRIES=10
RETRY_BACKOFF=2

# Shared
PING_INTERVAL=30
