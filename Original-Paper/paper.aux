\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Experiment C: Replica count over the experiment timeline. The ``flat bridge'' maintained at 8~replicas across DROP~1 ($t \approx 160$-$260$~s) is the primary empirical evidence of correct stabilization window operation. For comparison, at the equivalent elapsed time in Experiment B3, the HPA had already permanently destroyed 56 client connections via pod termination. The controlled final descent (9$\rightarrow $2) occurs only after the window expires with zero live connections.}}{17}{}\protected@file@percent }
\newlabel{fig:exp_c_replicas}{{15}{17}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}FINAL DROP: Controlled and Graceful Scale-Down}{17}{}\protected@file@percent }
