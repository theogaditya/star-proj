\newlabel{sec:problem}{{4}{7}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Instrumented server: definition and rationale}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Experiment A: HPA Baseline Under Monotonic Correlated Load}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Hypothesis.}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Experimental Setup.}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Results.}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Experiment B1: HPA Under Cyclic Load - Over-Provisioning and Recovery Asymmetry}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Hypothesis.}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Experiment A: Replica count timeline under monotonic WebSocket load with CPU $\propto $ connections. The clean staircase ascent (2$\rightarrow $5), flat stabilization plateau, and controlled descent to the minimum represent the theoretical ideal for HPA - achievable only under perfect signal-to-demand correlation.}}{8}{}\protected@file@percent }
\newlabel{fig:exp_a_replicas}{{5}{8}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Experimental Setup.}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Results.}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Experiment B1: HPA saturates at \texttt  {maxReplicas=15} within 99~seconds under cyclic load, representing an 87.5\% over-provision relative to the connection-derived optimum. Recovery to the minimum requires $\sim $650~seconds, demonstrating severe asymmetry between scale-up and scale-down responsiveness.}}{8}{}\protected@file@percent }
\newlabel{fig:exp_b1_replicas}{{6}{8}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Experiment B2-Instrumented: Quantifying Reconnection Storm Intensity}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Methodological note: supersession of a non-instrumented pilot}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Hypothesis.}{9}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Experimental Setup.}{9}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Results.}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Experiment B2-Instrumented: Prometheus-measured reconnection rate (\texttt  {rate(new\_connections\_total[15s])}) over the five-cycle experiment. Each reconnection spike is precisely synchronized with an HPA scale-down event, with peak observed rates of 1,400~connections/second.}}{9}{}\protected@file@percent }
\newlabel{fig:exp_b2_reconnections}{{7}{9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Experiment B2-Instrumented: Active connection count during the reconnection storm period. The connection overshoot of 1,215 (51.9\% above the 800-client target) arises as reconnecting clients establish new sessions before the server has fully released the state associated with severed connections.}}{9}{}\protected@file@percent }
\newlabel{fig:exp_b2_connections}{{8}{9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Experiment B2-Instrumented: Temporal correlation between HPA replica changes (green) and active connection count (blue). Each downward step in replicas corresponds to a measurable spike in the connection disruption signal, confirming the direct causal relationship.}}{10}{}\protected@file@percent }
\newlabel{fig:exp_b2_scaling}{{9}{10}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Experiment B3: Permanent Connection Loss Under Non-Reconnecting Clients}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Hypothesis.}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Experimental Setup.}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Pod termination mechanics and the 30-second limbo}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Results.}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Summary of the Evidence Chain}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Experiment B3: Active connection count exhibits permanent staircase destruction (800$\rightarrow $744$\rightarrow $697$\rightarrow $445$\rightarrow $79). Each step-down is precisely synchronized with an HPA scale-down event. The connections are irrecoverable under the \texttt  {reconnect: false} regimen.}}{11}{}\protected@file@percent }
\newlabel{fig:exp_b3_connections}{{10}{11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Experiment B3, combined signal view - the causal proof of the mismatch between CPU-based scaling signals and stateful workload characteristics. CPU utilization (red) drops to near zero as connections become idle $\rightarrow $ HPA scales down the replica count (green) $\rightarrow $ active connections (blue) are permanently destroyed. The autoscaler is induced by its own metric to destroy the session state it should be protecting.}}{11}{}\protected@file@percent }
\newlabel{fig:exp_b3_combined}{{11}{11}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Summary of the progressive evidence chain demonstrating the failure of CPU-based HPA for stateful WebSocket workloads. Each experiment isolates and quantifies a distinct failure mode.}}{11}{}\protected@file@percent }
\newlabel{tab:failure_summary}{{1}{11}{}{}{}}
